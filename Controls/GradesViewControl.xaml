<UserControl x:Class="UniversitySystem.Controls.GradesViewControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="📈" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Мои оценки" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="DisciplineFilter" Width="250" Padding="10" DisplayMemberPath="Name" SelectionChanged="FilterChanged"/>
            <ComboBox x:Name="SemesterFilter" Width="100" Margin="10,0,0,0" Padding="10" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
            </ComboBox>
        </StackPanel>
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="1" x:Name="GradesDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дисциплина" Binding="{Binding DisciplineName}" Width="*"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="80"/>
                        <DataGridTextColumn Header="Оценка" Binding="{Binding Value}" Width="60"/>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=d}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="Средний балл: " FontSize="16" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock x:Name="AvgTextBox" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#4A00E0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
