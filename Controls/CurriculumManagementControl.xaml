<UserControl x:Class="UniversitySystem.Controls.CurriculumManagementControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="📋" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Учебный план" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="GroupFilter" Width="150" Padding="10" DisplayMemberPath="Name" SelectionChanged="FilterChanged"/>
                        <Button Content="➕ Добавить" Background="#4A00E0" Foreground="White" Padding="16,10" BorderThickness="0" Margin="10,0,0,0" MinWidth="120" MinHeight="40" Click="AddCurriculum_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="CurriculumDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="CurriculumDataGrid_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Дисциплина" Binding="{Binding Discipline.Name}" Width="*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group.Name}" Width="100"/>
                            <DataGridTextColumn Header="Семестр" Binding="{Binding Semester}" Width="80"/>
                            <DataGridTextColumn Header="Год" Binding="{Binding AcademicYear}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Детали учебного плана" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Дисциплина" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="DisciplineComboBox" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Группа" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Семестр" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="SemesterTextBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Учебный год (2024-2025)" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="YearTextBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" Foreground="White" Padding="16,10" MinWidth="120" MinHeight="40" Click="SaveCurriculum_Click"/>
                        <Button Content="❌ Отмена" Background="#E0E0E0" Foreground="#333" Padding="16,10" Margin="10,0,0,0" MinWidth="100" MinHeight="40" Click="CancelCurriculum_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
