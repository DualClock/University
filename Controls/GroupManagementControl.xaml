<UserControl x:Class="UniversitySystem.Controls.GroupManagementControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="👥" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Управление группами" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="DepartmentFilter" Width="200" Padding="10" DisplayMemberPath="Name" SelectionChanged="FilterChanged"/>
                        <TextBox x:Name="SearchTextBox" Width="200" Margin="10,0,0,0" Padding="10" TextChanged="FilterChanged"/>
                        <Button Content="➕ Добавить" Background="#4A00E0" Foreground="White" Padding="16,10" BorderThickness="0" Margin="10,0,0,0" MinWidth="120" MinHeight="40" Click="AddGroup_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="GroupDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="GroupDataGrid_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Год поступления" Binding="{Binding Year}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Детали группы" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Название" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="GroupNameTextBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Кафедра" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="DepartmentComboBox" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Год поступления" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="YearTextBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" Foreground="White" Padding="16,10" MinWidth="120" MinHeight="40" Click="SaveGroup_Click"/>
                        <Button Content="❌ Отмена" Background="#E0E0E0" Foreground="#333" Padding="16,10" Margin="10,0,0,0" MinWidth="100" MinHeight="40" Click="CancelGroup_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
