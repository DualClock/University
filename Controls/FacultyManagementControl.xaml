<UserControl x:Class="UniversitySystem.Controls.FacultyManagementControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            
            <!-- Список -->
            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="24" Margin="0,0,16,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" Direction="320" ShadowDepth="3"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox x:Name="SearchTextBox" Width="260" Padding="14,10" FontSize="14" BorderThickness="0" Background="#F5F5F7" TextChanged="SearchTextBox_TextChanged"/>
                        <Button Content="➕ Добавить" Background="#4A00E0" Foreground="White" Padding="16,10" BorderThickness="0" Margin="12,0,0,0" FontWeight="SemiBold" MinWidth="120" MinHeight="40" Click="AddFaculty_Click"/>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="1" x:Name="FacultyDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="FacultyDataGrid_SelectionChanged" Background="Transparent" BorderThickness="0" RowHeight="48" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            
            <!-- Детали -->
            <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" Direction="320" ShadowDepth="3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📋 Информация о факультете" FontSize="16" FontWeight="Bold" Foreground="#1A1A2E" Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Название" FontSize="12" Foreground="#666" Margin="0,0,0,6"/>
                    <TextBox x:Name="FacultyNameTextBox" Padding="14,12" FontSize="14" Background="#F5F5F7" BorderThickness="0" Margin="0,0,0,20"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" Foreground="White" Padding="20,12" FontWeight="SemiBold" MinWidth="120" MinHeight="44" Click="SaveFaculty_Click"/>
                        <Button Content="Очистить" Background="#E0E0E0" Foreground="#333" Padding="20,12" Margin="10,0,0,0" FontWeight="Medium" MinWidth="100" MinHeight="44" Click="ClearForm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
