<UserControl x:Class="UniversitySystem.Controls.DisciplineManagementControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="📚" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Управление дисциплинами" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="SearchTextBox" Width="250" Padding="10" TextChanged="SearchTextBox_TextChanged"/>
                        <Button Content="➕ Добавить" Background="#4A00E0" Foreground="White" Padding="16,10" BorderThickness="0" Margin="10,0,0,0" MinWidth="120" MinHeight="40" Click="AddDiscipline_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="DisciplineDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="DisciplineDataGrid_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="Кред." Binding="{Binding Credits}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Детали дисциплины" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Название" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="NameTextBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Код" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="CodeTextBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Кредиты" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="CreditsTextBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" Foreground="White" Padding="16,10" MinWidth="120" MinHeight="40" Click="SaveDiscipline_Click"/>
                        <Button Content="❌ Отмена" Background="#E0E0E0" Foreground="#333" Padding="16,10" Margin="10,0,0,0" MinWidth="100" MinHeight="40" Click="CancelDiscipline_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
