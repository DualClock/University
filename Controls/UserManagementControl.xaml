<UserControl x:Class="UniversitySystem.Controls.UserManagementControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="👤" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Управление пользователями" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="RoleFilter" Width="120" Padding="10" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="Все" IsSelected="True"/>
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="Teacher"/>
                            <ComboBoxItem Content="Student"/>
                        </ComboBox>
                        <ComboBox x:Name="GroupFilter" Width="120" Padding="10" DisplayMemberPath="Name" SelectionChanged="FilterChanged"/>
                        <TextBox x:Name="SearchTextBox" Width="200" Margin="10,0,0,0" Padding="10" TextChanged="FilterChanged"/>
                        <Button Content="➕ Добавить" Background="#4A00E0" Foreground="White" Padding="16,10" BorderThickness="0" Margin="10,0,0,0" MinWidth="110" Click="AddUser_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="UserDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="UserDataGrid_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="100"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Данные пользователя" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Логин" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="LoginTextBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Пароль" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="ФИО" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="FullNameTextBox" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Роль" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="RoleComboBox">
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="Teacher"/>
                            <ComboBoxItem Content="Student"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Группа" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" Foreground="White" Padding="16,10" MinWidth="110" Click="SaveUser_Click"/>
                        <Button Content="❌ Отмена" Background="#999" Foreground="White" Padding="16,10" Margin="10,0,0,0" Click="CancelUser_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
