<UserControl x:Class="UniversitySystem.Controls.ScheduleControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="📅" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Расписание занятий" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox x:Name="GroupFilter" Width="150" Padding="10" DisplayMemberPath="Name" SelectionChanged="FilterChanged"/>
                        <ComboBox x:Name="DayFilter" Width="120" Margin="10,0,0,0" Padding="10" SelectionChanged="FilterChanged">
                            <ComboBoxItem Content="Понедельник" Tag="1"/>
                            <ComboBoxItem Content="Вторник" Tag="2"/>
                            <ComboBoxItem Content="Среда" Tag="3"/>
                            <ComboBoxItem Content="Четверг" Tag="4"/>
                            <ComboBoxItem Content="Пятница" Tag="5"/>
                            <ComboBoxItem Content="Суббота" Tag="6"/>
                        </ComboBox>
                        <Button Content="➕ Добавить" Background="#4A00E0" Foreground="White" Padding="15,8" BorderThickness="0" Margin="10,0,0,0" Click="AddSchedule_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="ScheduleDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ScheduleDataGrid_SelectionChanged" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="День" Binding="{Binding DayOfWeek}" Width="80"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding StartTime}" Width="80"/>
                            <DataGridTextColumn Header="Дисциплина" Binding="{Binding Discipline.Name}" Width="*"/>
                            <DataGridTextColumn Header="Аудитория" Binding="{Binding Room}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Занятие" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="День недели" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="DayComboBox">
                            <ComboBoxItem Content="Понедельник" Tag="1"/>
                            <ComboBoxItem Content="Вторник" Tag="2"/>
                            <ComboBoxItem Content="Среда" Tag="3"/>
                            <ComboBoxItem Content="Четверг" Tag="4"/>
                            <ComboBoxItem Content="Пятница" Tag="5"/>
                            <ComboBoxItem Content="Суббота" Tag="6"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Время (09:00)" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="TimeTextBox" Padding="10" Text="09:00"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Группа" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Дисциплина" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="DisciplineComboBox" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Аудитория" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="RoomTextBox" Padding="10"/>
                    </StackPanel>
                    <TextBlock x:Name="ConflictWarning" Foreground="#E53935" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" Foreground="White" Padding="15,8" Click="SaveSchedule_Click"/>
                        <Button Content="❌ Отмена" Background="#999" Foreground="White" Padding="15,8" Margin="10,0,0,0" Click="CancelSchedule_Click"/>
                        <Button Content="🗑️ Удалить" Background="#E53935" Foreground="White" Padding="15,8" Margin="10,0,0,0" Click="DeleteSchedule_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
