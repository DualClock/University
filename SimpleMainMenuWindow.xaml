<Window x:Class="UniversitySystem.SimpleMainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="University System - Главное меню"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="University System" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBlock x:Name="TxtUserInfo" Text="Пользователь: " VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Выйти" Click="BtnLogout_Click" Margin="0,0,0,0"/>
        </StackPanel>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка - Администрирование -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Администрирование" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button x:Name="BtnManageFaculties" Content="Управление факультетами" Height="40" Margin="0,0,0,5"/>
                <Button x:Name="BtnManageDepartments" Content="Управление кафедрами" Height="40" Margin="0,0,0,5"/>
                <Button x:Name="BtnManageGroups" Content="Управление группами" Height="40" Margin="0,0,0,5"/>
                <Button x:Name="BtnManageDisciplines" Content="Управление дисциплинами" Height="40" Margin="0,0,0,5"/>
                <Button x:Name="BtnManageUsers" Content="Управление пользователями" Height="40" Margin="0,0,0,5"/>
                <Button x:Name="BtnManageCurriculum" Content="Учебный план" Height="40" Margin="0,0,0,5"/>
            </StackPanel>

            <!-- Правая колонка - Работа с оценками -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Работа с оценками" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button x:Name="BtnManageGrades" Content="Ввод оценок" Height="40" Margin="0,0,0,5"/>
                <Button x:Name="BtnViewSchedule" Content="Расписание" Height="40" Margin="0,0,0,5"/>
                <Button x:Name="BtnViewGrades" Content="Просмотр оценок" Height="40" Margin="0,0,0,5"/>
                
                <TextBlock Text="Отчеты и аналитика" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
                <Button x:Name="BtnReports" Content="Статистика и отчеты" Height="40" Margin="0,0,0,5"/>
                <Button x:Name="BtnExport" Content="Экспорт данных" Height="40" Margin="0,0,0,5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>