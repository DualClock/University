<Window x:Class="UniversitySystem.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Экспорт данных"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="📤 Экспорт данных" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>
            <Border Background="White" CornerRadius="12" Padding="25">
                <StackPanel>
                    <TextBlock Text="Выберите тип данных для экспорта:" FontSize="14" Margin="0,0,0,20"/>
                    <RadioButton x:Name="GradesRadio" Content="📝 Журнал оценок" GroupName="ExportType" IsChecked="True" Margin="0,0,0,10" FontSize="14"/>
                    <RadioButton x:Name="StudentsRadio" Content="👥 Список студентов" GroupName="ExportType" Margin="0,0,0,10" FontSize="14"/>
                    <RadioButton x:Name="ScheduleRadio" Content="📅 Расписание занятий" GroupName="ExportType" Margin="0,0,0,10" FontSize="14"/>
                    <RadioButton x:Name="GroupsRadio" Content="👥 Список групп" GroupName="ExportType" Margin="0,0,0,10" FontSize="14"/>
                    <RadioButton x:Name="DisciplinesRadio" Content="📚 Дисциплины" GroupName="ExportType" Margin="0,0,0,20" FontSize="14"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="📥 Экспорт в Excel" Background="#4A00E0" FontSize="12" Foreground="White" Padding="20,10" BorderThickness="0" Click="Export_Click"/>
                        <Button Content="🖨️ Печать" Background="#8E2DE2" Foreground="White" Padding="20,10" BorderThickness="0" Margin="15,0,0,0" Click="Print_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
