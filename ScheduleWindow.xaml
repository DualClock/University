<Window x:Class="UniversitySystem.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Расписание"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBlock Text="📅" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Расписание занятий" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <ComboBox x:Name="GroupFilterComboBox" Width="180" DisplayMemberPath="Name" SelectedValuePath="Id" materialDesign:HintAssist.Hint="Группа" SelectionChanged="Filter_Changed"/>
                        <ComboBox x:Name="DayFilterComboBox" Width="120" Margin="10,0,0,0" materialDesign:HintAssist.Hint="День недели" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="Понедельник" Tag="1"/>
                            <ComboBoxItem Content="Вторник" Tag="2"/>
                            <ComboBoxItem Content="Среда" Tag="3"/>
                            <ComboBoxItem Content="Четверг" Tag="4"/>
                            <ComboBoxItem Content="Пятница" Tag="5"/>
                            <ComboBoxItem Content="Суббота" Tag="6"/>
                            <ComboBoxItem Content="Все дни" Tag="0"/>
                        </ComboBox>
                        <Button Content="➕ Добавить" Background="#4A00E0" Foreground="White" Padding="15,8" BorderThickness="0" Margin="10,0,0,0" Click="AddSchedule_Click" Height="39"/>
                        <Button Content="🗑️ Удалить" Background="#FF4444" Foreground="White" Padding="15,8" BorderThickness="0" Click="DeleteSchedule_Click" Height="39"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="ScheduleDataGrid" Margin="0,10,0,0"
                             AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                             SelectionMode="Single" SelectionChanged="ScheduleDataGrid_SelectionChanged"
                             Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group.Name}" Width="100"/>
                            <DataGridTextColumn Header="Дисциплина" Binding="{Binding Discipline.Name}" Width="*"/>
                            <DataGridTextColumn Header="День" Binding="{Binding DayOfWeek}" Width="80"/>
                            <DataGridTextColumn Header="Время" Width="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="StartTime" StringFormat="{}{0:HH:mm}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Аудитория" Binding="{Binding Room}" Width="80"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Детали занятия" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Группа *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#F5F5F5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Дисциплина *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="DisciplineComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#F5F5F5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="День недели *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="DayComboBox" SelectedIndex="0" Background="#F5F5F5">
                            <ComboBoxItem Content="Понедельник" Tag="1"/>
                            <ComboBoxItem Content="Вторник" Tag="2"/>
                            <ComboBoxItem Content="Среда" Tag="3"/>
                            <ComboBoxItem Content="Четверг" Tag="4"/>
                            <ComboBoxItem Content="Пятница" Tag="5"/>
                            <ComboBoxItem Content="Суббота" Tag="6"/>
                        </ComboBox>
                    </StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Начало" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox x:Name="StartTimeTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10" Text="09:00"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Конец" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox x:Name="EndTimeTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10" Text="10:30"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Аудитория *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="RoomTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Тип занятия *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="TypeComboBox" SelectedIndex="0" Background="#F5F5F5">
                            <ComboBoxItem Content="Лекция" Tag="Lecture"/>
                            <ComboBoxItem Content="Семинар" Tag="Seminar"/>
                            <ComboBoxItem Content="Лаб. работа" Tag="Lab"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" Foreground="White" Padding="0" BorderThickness="0" Click="SaveSchedule_Click" Width="100"/>
                        <Button Content="❌ Отмена" Background="#999" Foreground="White" Padding="0" BorderThickness="0" Margin="10,0,0,0" Click="CancelSchedule_Click" Width="84"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
