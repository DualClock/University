<Window x:Class="UniversitySystem.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Статистика и отчеты"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBlock Text="📈" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Статистика и отчеты" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="📊 Статистика по группе" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox x:Name="GroupComboBox" Width="200" DisplayMemberPath="Name" SelectedValuePath="Id" materialDesign:HintAssist.Hint="Группа" SelectionChanged="Group_SelectionChanged"/>
                            <Button Content="📊 Показать" FontSize="12" Background="#4A00E0" Foreground="White" Padding="15,8" BorderThickness="0" Margin="10,0,0,0" Click="ShowStats_Click"/>
                            <Button Content="📥 Экспорт" FontSize="12" Background="#8E2DE2" Foreground="White" Padding="15,8" BorderThickness="0" Margin="10,0,0,0" Click="ExportStats_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1">
                        <Border Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Общая статистика" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,5"><TextBlock Text="Всего студентов:" Foreground="#666"/><TextBlock x:Name="TotalStudentsText" FontSize="18" FontWeight="Bold"/></StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,5"><TextBlock Text="Средний балл:" Foreground="#666"/><TextBlock x:Name="AvgGradeText" FontSize="18" FontWeight="Bold" Foreground="#4A00E0"/></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5"><TextBlock Text="Отличники (5):" Foreground="#666"/><TextBlock x:Name="ExcellentText" FontSize="16" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5"><TextBlock Text="Хорошисты (4):" Foreground="#666"/><TextBlock x:Name="GoodText" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,5"><TextBlock Text="Удовлетворительно (3):" Foreground="#666"/><TextBlock x:Name="SatisfactoryText" FontSize="16" FontWeight="Bold" Foreground="#F57C00"/></StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,5"><TextBlock Text="Неудовлетворительно (2):" Foreground="#666"/><TextBlock x:Name="FailText" FontSize="16" FontWeight="Bold" Foreground="#C62828"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="📋 Должники" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox x:Name="DebtorsGroupComboBox" Width="200" DisplayMemberPath="Name" SelectedValuePath="Id" materialDesign:HintAssist.Hint="Группа"/>
                            <Button Content="🔍 Найти" Background="#4A00E0" Foreground="White" Padding="15,8" BorderThickness="0" Margin="10,0,0,0" Click="FindDebtors_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="DebtorsDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="*"/>
                            <DataGridTextColumn Header="Дисциплина" Binding="{Binding DisciplineName}" Width="*"/>
                            <DataGridTextColumn Header="Кол-во долгов" Binding="{Binding DebtCount}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
