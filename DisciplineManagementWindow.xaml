<Window x:Class="UniversitySystem.DisciplineManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Управление дисциплинами"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBlock Text="📚" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Управление дисциплинами" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBox x:Name="SearchTextBox" Width="250" Padding="10" Background="#F5F5F5"
                                 materialDesign:HintAssist.Hint="Поиск по названию..."
                                 TextChanged="SearchTextBox_TextChanged"/>
                        <Button Content="➕ Добавить" FontSize="12" Background="#4A00E0" Foreground="White" Padding="5" BorderThickness="0" Margin="10,0,0,0" Click="AddDiscipline_Click"/>
                        <Button Content="✏️ Редактор" FontSize="12" Background="#8E2DE2" Foreground="White" Padding="5" BorderThickness="0" Click="EditDiscipline_Click"/>
                        <Button Content="🗑️ Удалить" FontSize="12" Background="#FF4444" Foreground="White" Padding="5" BorderThickness="0" Click="DeleteDiscipline_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="DisciplineDataGrid" Margin="0,10,0,0"
                             AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                             SelectionMode="Single" SelectionChanged="DisciplineDataGrid_SelectionChanged"
                             Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="Часы лекций" Binding="{Binding LectureHours}" Width="90"/>
                            <DataGridTextColumn Header="Часы семинаров" Binding="{Binding SeminarHours}" Width="100"/>
                            <DataGridTextColumn Header="Часы лаб." Binding="{Binding LabHours}" Width="80"/>
                            <DataGridTextColumn Header="Кредиты" Binding="{Binding Credits}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Детали дисциплины" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Название *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="DisciplineNameTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Код *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="DisciplineCodeTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10" MaxLength="20"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,10">
                            <TextBlock Text="Лекции" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox x:Name="LectureHoursTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="8" PreviewTextInput="NumericTextBox_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,5,10">
                            <TextBlock Text="Семинары" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox x:Name="SeminarHoursTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="8" PreviewTextInput="NumericTextBox_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="5,0,0,10">
                            <TextBlock Text="Лаб. работы" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox x:Name="LabHoursTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="8" PreviewTextInput="NumericTextBox_PreviewTextInput"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Кредиты *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="CreditsTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10" PreviewTextInput="NumericTextBox_PreviewTextInput"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" Foreground="White" Padding="15,8" BorderThickness="0" FontSize="12" Click="SaveDiscipline_Click"/>
                        <Button Content="❌ Отмена" Background="#999" Foreground="White" Padding="15,8" BorderThickness="0" FontSize="12" Margin="10,0,0,0" Click="CancelDiscipline_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
