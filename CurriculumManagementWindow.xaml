<Window x:Class="UniversitySystem.CurriculumManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Учебный план"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBlock Text="📋" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Учебный план" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <ComboBox x:Name="GroupFilterComboBox" Width="180" DisplayMemberPath="Name" SelectedValuePath="Id" materialDesign:HintAssist.Hint="Группа" SelectionChanged="Filter_SelectionChanged"/>
                        <ComboBox x:Name="SemesterFilterComboBox" Width="100" Margin="10,0,0,0" materialDesign:HintAssist.Hint="Семестр" SelectionChanged="Filter_SelectionChanged"/>
                        <TextBox x:Name="YearFilterTextBox" Width="120" FontSize="12" Padding="8" Background="#F5F5F5" Margin="10,0,0,0" materialDesign:HintAssist.Hint="Учебный год" TextChanged="Filter_TextChanged"/>
                        <Button Content="➕ Добавить" FontSize="12" Background="#4A00E0" Foreground="White" Padding="15,8" BorderThickness="0" Margin="10,0,0,0" Click="AddCurriculum_Click"/>
                        <Button Content="🗑️ Удалить" Background="#FF4444" Foreground="White" Padding="15,8" BorderThickness="0" Click="DeleteCurriculum_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="CurriculumDataGrid" Margin="0,10,0,0"
                             AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                             SelectionMode="Single" SelectionChanged="CurriculumDataGrid_SelectionChanged"
                             Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group.Name}" Width="120"/>
                            <DataGridTextColumn Header="Дисциплина" Binding="{Binding Discipline.Name}" Width="*"/>
                            <DataGridTextColumn Header="Семестр" Binding="{Binding Semester}" Width="80"/>
                            <DataGridTextColumn Header="Учебный год" Binding="{Binding AcademicYear}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Детали учебного плана" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Группа *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#F5F5F5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Дисциплина *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="DisciplineComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#F5F5F5"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Семестр *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="SemesterComboBox" SelectedIndex="0" Background="#F5F5F5">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="6"/>
                            <ComboBoxItem Content="7"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Учебный год *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="YearTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10" Text="2025/2026"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" Foreground="White" Padding="15,8" BorderThickness="0" Click="SaveCurriculum_Click"/>
                        <Button Content="❌ Отмена" Background="#999" Foreground="White" Padding="15,8" BorderThickness="0" Margin="10,0,0,0" Click="CancelCurriculum_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
