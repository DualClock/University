<Window x:Class="UniversitySystem.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Управление пользователями"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBlock Text="👤" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Управление пользователями" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <ComboBox x:Name="RoleFilterComboBox" Width="150" SelectionChanged="RoleFilter_SelectionChanged">
                            <ComboBoxItem Content="Все роли" IsSelected="True"/>
                            <ComboBoxItem Content="Студент"/>
                            <ComboBoxItem Content="Преподаватель"/>
                            <ComboBoxItem Content="Администратор"/>
                        </ComboBox>
                        <ComboBox x:Name="GroupFilterComboBox" Width="150" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="10,0,0,0" SelectionChanged="GroupFilter_SelectionChanged"/>
                        <TextBox x:Name="SearchTextBox" Width="200" Padding="0" Background="#F5F5F5" Margin="10,0,0,0" materialDesign:HintAssist.Hint="Поиск..." TextChanged="SearchTextBox_TextChanged"/>
                        <Button Content="➕ Добавить" Background="#4A00E0" Foreground="White" Padding="15,8" BorderThickness="0" Margin="10,0,0,0" Click="AddUser_Click"/>
                        <Button Content="✏️ Редактировать" Background="#8E2DE2" Foreground="White" Padding="15,8" BorderThickness="0" Click="EditUser_Click"/>
                        <Button Content="🗑️ Удалить" Background="#FF4444" Foreground="White" Padding="15,8" BorderThickness="0" Click="DeleteUser_Click"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="UserDataGrid" Margin="0,10,0,0"
                             AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                             SelectionMode="Single" SelectionChanged="UserDataGrid_SelectionChanged"
                             Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="100"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group.Name}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Данные пользователя" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Логин *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="LoginTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10" MaxLength="50"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Пароль *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="ФИО *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="FullNameTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10" MaxLength="100"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Email" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <TextBox x:Name="EmailTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Роль *" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="RoleComboBox" Margin="0">
                            <ComboBoxItem Content="Student" Tag="Student"/>
                            <ComboBoxItem Content="Teacher" Tag="Teacher"/>
                            <ComboBoxItem Content="Admin" Tag="Admin"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Группа" FontSize="12" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#F5F5F5"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,15,-10,0">
                        <Button Content="💾 Сохранить" Background="#4A00E0" FontSize="12" Foreground="White" Padding="0" BorderThickness="0" Click="SaveUser_Click" Height="30"/>
                        <Button Content="❌ Отмена" Background="#999" Foreground="White" FontSize="12" Padding="5" BorderThickness="0" Margin="12,0,0,0" Click="CancelUser_Click" Height="30"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
