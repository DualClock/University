<Window x:Class="UniversitySystem.FacultyManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление факультетами"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
            <TextBlock Text="🏛️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Управление факультетами" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Список факультетов -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="➕ Добавить" FontSize="12" 
                                Background="#4A00E0" 
                                Foreground="White" 
                                Padding="15,8" 
                                BorderThickness="0"
                                Click="AddFaculty_Click"/>
                        <Button Content="✏️ Редактировать"  FontSize="12"
                                Background="#8E2DE2" 
                                Foreground="White" 
                                Padding="15,8" 
                                BorderThickness="0"
                                Click="EditFaculty_Click"/>
                        <Button Content="🗑️ Удалить" 
                                Background="#FF4444" FontSize="12"
                                Foreground="White" 
                                Padding="15,8" 
                                BorderThickness="0"
                                Click="DeleteFaculty_Click"/>
                    </StackPanel>

                    <!-- Список -->
                    <DataGrid Grid.Row="1" 
                             x:Name="FacultyDataGrid"
                             Margin="0,15,0,0"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             SelectionMode="Single"
                             Background="Transparent"
                             BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Панель деталей -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock Text="Детали факультета" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                    
                    <StackPanel Margin="0,0,0,5">
                        <TextBlock Text="Название" FontSize="12" Foreground="#666"/>
                        <TextBox x:Name="FacultyNameTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,5">
                        <TextBlock Text="Декан" FontSize="12" Foreground="#666"/>
                        <TextBox x:Name="DeanTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,5">
                        <TextBlock Text="Email" FontSize="12" Foreground="#666"/>
                        <TextBox x:Name="EmailTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,5">
                        <TextBlock Text="Телефон" FontSize="12" Foreground="#666"/>
                        <TextBox x:Name="PhoneTextBox" Background="#F5F5F5" BorderThickness="1" BorderBrush="#E0E0E0" Padding="10"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SaveFacultyButton" FontSize="12"
                                Content="💾 Сохранить" 
                                Background="#4A00E0" 
                                Foreground="White" 
                                Padding="15,8" 
                                BorderThickness="0"
                                Click="SaveFaculty_Click"/>
                        <Button x:Name="CancelFacultyButton" FontSize="12"
                                Content="❌ Отмена" 
                                Background="#999" 
                                Foreground="White" 
                                Padding="15,8" 
                                BorderThickness="0"
                                Click="CancelFaculty_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>