<Window x:Class="UniversitySystem.GradeManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Ввод оценок"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBlock Text="📝" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Ввод оценок" FontSize="20" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="GroupComboBox" Width="180" DisplayMemberPath="Name" SelectedValuePath="Id" materialDesign:HintAssist.Hint="Группа" SelectionChanged="GroupComboBox_SelectionChanged"/>
                    <ComboBox x:Name="DisciplineComboBox" Width="220" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="10,0,0,0" materialDesign:HintAssist.Hint="Дисциплина" SelectionChanged="GroupComboBox_SelectionChanged"/>
                    <ComboBox x:Name="SemesterComboBox" Width="80" Margin="10,0,0,0" materialDesign:HintAssist.Hint="Семестр">
                        <ComboBoxItem Content="1"/>
                        <ComboBoxItem Content="2"/>
                        <ComboBoxItem Content="3"/>
                        <ComboBoxItem Content="4"/>
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="6"/>
                        <ComboBoxItem Content="7"/>
                        <ComboBoxItem Content="8"/>
                    </ComboBox>
                    <TextBox x:Name="YearTextBox" Width="120" Padding="8" Background="#F5F5F5" Margin="10,0,0,0" materialDesign:HintAssist.Hint="Учебный год" Text="2025/2026"/>
                    <Button Content="🔍 Загрузить" Background="#4A00E0" Foreground="White" Padding="15,8" BorderThickness="0" Margin="15,0,0,0" Click="LoadGrades_Click"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,15,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <TextBlock Text="Тип оценки:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="ExamRadio" Content="Экзамен" GroupName="GradeType" IsChecked="True" Margin="0,0,15,0" Checked="GradeType_Changed"/>
                        <RadioButton x:Name="SeminarRadio" Content="Семинар" GroupName="GradeType" Margin="0,0,15,0" Checked="GradeType_Changed"/>
                        <RadioButton x:Name="LabRadio" Content="Лаб. работа" GroupName="GradeType" Margin="0,0,15,0" Checked="GradeType_Changed"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="GradesDataGrid" Margin="0,10,0,0"
                             AutoGenerateColumns="False" CanUserAddRows="False"
                             SelectionMode="Single" Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Студент" Binding="{Binding Student.FullName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Оценка" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Ввод" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox x:Name="GradeInputBox" Width="60" TextAlignment="Center" FontSize="14" Background="#E8F5E9"
                                                 PreviewTextInput="GradeInput_PreviewTextInput" TextChanged="GradeInput_TextChanged" Tag="{Binding Id}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="💾 Сохранить все" Background="#4A00E0" Foreground="White" Padding="20,10" BorderThickness="0" Click="SaveGrades_Click" Height="41"/>
                        <Button Content="🔄 Обновить" Background="#8E2DE2" Foreground="White" Padding="15,10" BorderThickness="0" Margin="10,0,0,0" Click="LoadGrades_Click" Height="41"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
