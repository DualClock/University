<UserControl x:Class="UniversitySystem.ReportsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Margin="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Отчеты и аналитика" 
                      FontSize="28" 
                      FontWeight="Bold"
                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Статистика успеваемости и рейтинги" 
                      FontSize="14"
                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                      Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Вкладки отчетов -->
        <TabControl Grid.Row="1">
            <!-- Рейтинг студентов -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Trophy" Margin="0,0,8,0"/>
                        <TextBlock Text="Рейтинг студентов"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Фильтры -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,16">
                        <ComboBox x:Name="CmbGroupForRating" 
                                 materialDesign:HintAssist.Hint="Группа"
                                 Width="200"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Id"
                                 Margin="0,0,8,0"/>
                        
                        <ComboBox x:Name="CmbDisciplineForRating" 
                                 materialDesign:HintAssist.Hint="Дисциплина"
                                 Width="250"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Id"
                                 Margin="0,0,8,0"/>
                        
                        <Button Content="Сформировать" 
                               Click="BtnGenerateRating_Click"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Margin="0,0,8,0"/>
                        
                        <Button Content="Экспорт в Excel" 
                               Click="BtnExportRating_Click"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Margin="0,0,8,0"/>
                    </WrapPanel>
                    
                    <!-- Таблица рейтинга -->
                    <DataGrid x:Name="DgRating" 
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserAddRows="False"
                             materialDesign:DataGridAssist.CellPadding="13,8,8,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Rank}" Width="60"/>
                            <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="150"/>
                            <DataGridTextColumn Header="Средний балл" Binding="{Binding AverageGrade, StringFormat={}{0:F2}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Статистика по группам -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartPie" Margin="0,0,8,0"/>
                        <TextBlock Text="Статистика по группам"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Фильтры -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,16">
                        <ComboBox x:Name="CmbGroupForStats" 
                                 materialDesign:HintAssist.Hint="Группа"
                                 Width="200"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Id"
                                 Margin="0,0,8,0"/>
                        
                        <Button Content="Показать" 
                               Click="BtnShowStats_Click"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Margin="0,0,8,0"/>
                        
                        <Button Content="Экспорт" 
                               Click="BtnExportStats_Click"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Margin="0,0,8,0"/>
                    </WrapPanel>
                    
                    <!-- Статистика -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Карточки статистики -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <materialDesign:Card Margin="0,0,0,16" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Средний балл группы" 
                                              FontSize="14"
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                                              Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtGroupAverage" 
                                              Text="0.00" 
                                              FontSize="32" 
                                              FontWeight="Bold"
                                              Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                </StackPanel>
                            </materialDesign:Card>
                            
                            <materialDesign:Card Margin="0,0,0,16" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Количество студентов" 
                                              FontSize="14"
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                                              Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtStudentCount" 
                                              Text="0" 
                                              FontSize="32" 
                                              FontWeight="Bold"
                                              Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                        
                        <!-- Детализация -->
                        <materialDesign:Card Grid.Column="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Распределение оценок" 
                                          FontSize="18"
                                          FontWeight="Bold"
                                          Margin="0,0,0,16"/>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Отлично (5): " Width="120"/>
                                    <TextBlock x:Name="TxtExcellent" Text="0" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Хорошо (4): " Width="120"/>
                                    <TextBlock x:Name="TxtGood" Text="0" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Удовл. (3): " Width="120"/>
                                    <TextBlock x:Name="TxtSatisfactory" Text="0" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Неуд (2): " Width="120"/>
                                    <TextBlock x:Name="TxtFail" Text="0" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Должники -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle" Margin="0,0,8,0"/>
                        <TextBlock Text="Должники"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Фильтры -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,16">
                        <ComboBox x:Name="CmbGroupForDebtors" 
                                 materialDesign:HintAssist.Hint="Группа"
                                 Width="200"
                                 DisplayMemberPath="Name"
                                 SelectedValuePath="Id"
                                 Margin="0,0,8,0"/>
                        
                        <Button Content="Найти" 
                               Click="BtnFindDebtors_Click"
                               Style="{StaticResource MaterialDesignRaisedButton}"
                               Margin="0,0,8,0"/>
                    </WrapPanel>
                    
                    <!-- Таблица должников -->
                    <DataGrid x:Name="DgDebtors" 
                             Grid.Row="1"
                             AutoGenerateColumns="False"
                             IsReadOnly="True"
                             CanUserAddRows="False"
                             materialDesign:DataGridAssist.CellPadding="13,8,8,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="150"/>
                            <DataGridTextColumn Header="Дисциплина" Binding="{Binding DisciplineName}" Width="*"/>
                            <DataGridTextColumn Header="Количество долгов" Binding="{Binding DebtCount}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>